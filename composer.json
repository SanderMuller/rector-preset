{
    "name": "sandermuller/rector-preset",
    "description": "Shared Rector presets for apps and packages, versioned with Rector.",
    "keywords": [
        "rector",
        "rector-preset",
        "static-analysis",
        "refactoring",
        "laravel"
    ],
    "homepage": "https://github.com/SanderMuller/rector-preset",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Sander Muller",
            "email": "github@scode.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "composer-runtime-api": "^2.2",
        "rector/rector": "~2.8.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7.2",
        "hihaho/rector-rules": "^1.2",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.29",
        "mrpunyapal/rector-pest": "^0.2.17",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-agent": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "pestphp/pest-plugin-rector": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "sandermuller/boost-skills": "^2.27.0",
        "sandermuller/laravel-fluent-validation-rector": "^1.11",
        "sandermuller/package-boost-php": "^1.0",
        "spaze/phpstan-disallowed-calls": "^4.13",
        "stolt/lean-package-validator": "^6.0.1",
        "symfony/process": "^8.1",
        "symplify/phpstan-rules": "^14.19",
        "tomasvotruba/cognitive-complexity": "^1.3",
        "tomasvotruba/type-coverage": "^2.3"
    },
    "suggest": {
        "driftingly/rector-laravel": "Enables the Laravel sets and skips when installed",
        "hihaho/rector-rules": "Enables HihahoSetList::ALL when installed",
        "mrpunyapal/rector-pest": "Enables the Pest code-quality and chain sets when installed",
        "pestphp/pest-plugin-rector": "Enables the Pest coding-style set when installed",
        "sandermuller/laravel-fluent-validation-rector": "Enables the FluentValidation sets when installed"
    },
    "conflict": {
        "driftingly/rector-laravel": "<2.7.2"
    },
    "autoload": {
        "psr-4": {
            "SanderMuller\\RectorPreset\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SanderMuller\\RectorPreset\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "SanderMuller\\PackageBoostPhp\\Scripts\\AutoSync::run"
        ],
        "post-update-cmd": [
            "SanderMuller\\PackageBoostPhp\\Scripts\\AutoSync::run"
        ],
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=2G",
        "phpstan-simplified": "vendor/bin/phpstan analyse --memory-limit=2G --error-format symplify",
        "phpstan-clear-cache": "vendor/bin/phpstan clear-result-cache",
        "format": "vendor/bin/pint",
        "rector": "vendor/bin/rector process",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "sync-ai": "vendor/bin/boost sync",
        "validate-gitattributes": "vendor/bin/lean-package-validator validate",
        "qa": [
            "@rector",
            "@format",
            "@phpstan-simplified",
            "@validate-gitattributes"
        ],
        "qa-check": [
            "vendor/bin/rector process --dry-run",
            "vendor/bin/pint --test",
            "@phpstan-simplified",
            "@validate-gitattributes",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
